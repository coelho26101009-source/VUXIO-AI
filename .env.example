# Server-only secrets. Never prefix these with VITE_.
# Configure them in Vercel Project Settings > Environment Variables as well.

# Groq — Standard Mode inference + Code Mode fallback
# Get your key at https://console.groq.com
GROQ_API_KEY=

# Google Gemini — Code Mode primary model
# Get your key at https://aistudio.google.com
GEMINI_API_KEY=

# Tavily — Web Mode real-time search
# Get your key at https://tavily.com
TAVILY_API_KEY=

# Firebase — Auth + Firestore
# Get these from Firebase Console > Project Settings > Your apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
